# Copy this file to .env and fill in your own values.
# Never commit your real .env file (it is already in .gitignore).

# Hugging Face access token. Required to download the gated
# google/gemma-3-1b-it model UNLESS you're using the GGUF backend
# (GGUF_MODEL_PATH below) - a pre-built GGUF file needs no HF auth at
# runtime. Create a token at https://huggingface.co/settings/tokens
# (a "Read" token is sufficient) and accept the Gemma license on the
# model page before using it: https://huggingface.co/google/gemma-3-1b-it
HF_TOKEN=

# --- Serving (scripts/serve.py / docker-compose.yml) - see README's
# "Serving" and "Deploying" sections ---

# Required to run the API at all - it fails closed (rejects every
# request) without this set. Choose your own secret value.
API_KEY=

# Browser widget origins. Empty disables browser cross-origin access; list the
# production site explicitly, e.g. https://technyxsystems.com.
CORS_ORIGINS=
TRUST_PROXY=0
VISITOR_RATE_LIMIT_MAX_REQUESTS=10
VISITOR_RATE_LIMIT_WINDOW_SECONDS=60
QUEUE_TIMEOUT_SECONDS=60

# API listener and retrieval data.
HOST=127.0.0.1
PORT=8000

# Postgres with pgvector holding the knowledge base - a Supabase project's
# connection string (Project Settings -> Database -> Connection string).
#   - API/serving: the Transaction pooler (port 6543) or Session pooler (5432) both work.
#   - scripts/migrate.py and scripts/sync_facts.py: use the Direct connection or
#     the Session pooler (port 5432).
# Use the *server-side* database password. Never expose this to the browser.
DATABASE_URL=

# Which embedding checkpoint retrieval.py loads (see
# src/chatbot_rag/retrieval.py's _MODEL_CONFIGS for supported models and
# their pooling strategy). Leave blank to default to BAAI/bge-base-en-v1.5
# (768 dimensions, matching the database column).
# Changing this requires re-embedding - `python scripts/sync_facts.py --full` -
# and open_index() refuses a database built with a different model. A model with
# a different dimension also needs a migration (the column is vector(768)).
EMBEDDING_MODEL=

# Keep this separate from API_KEY: Prometheus sends it as X-Metrics-Key.
METRICS_KEY=

# In-process only: sessions are lost on restart and are not shared by replicas.
SESSION_MAX_CONVERSATIONS=1000
SESSION_TTL_SECONDS=3600
CONVERSATION_LOG_PATH=logs/conversations.jsonl

# Which generate_fn backend api.py loads at startup - "plain" (default,
# local PyTorch/transformers), "gguf" (local llama.cpp, needs
# GGUF_MODEL_PATH below), or "api" (a remote OpenAI-compatible endpoint,
# needs the LLM_API_* vars below - OpenAI, DeepSeek, Groq, etc.). Leave
# blank to keep the old behavior: "gguf" if GGUF_MODEL_PATH is set, else
# "plain".
LLM_BACKEND=

# --- LLM_BACKEND=plain ---
# Hugging Face model id for the plain backend. Defaults to
# google/gemma-3-1b-it (gated - accept its license and set HF_TOKEN above)
# if left blank; any other causal-LM checkpoint on the Hub works too.
MODEL_NAME=

# Optional - path to a GGUF file from scripts/export_gguf.py. Set this to
# use the fast backend (~12.8 tok/s vs ~1.6-2.9 tok/s - see README's
# "Speed"); leave blank to use the plain PyTorch backend (needs HF_TOKEN
# above instead).
GGUF_MODEL_PATH=

# --- LLM_BACKEND=api - any OpenAI-compatible /chat/completions provider ---
# DeepSeek: base_url=https://api.deepseek.com, model=deepseek-chat
# OpenAI:   base_url=https://api.openai.com/v1, model=gpt-4o-mini (etc.)
# Groq:     base_url=https://api.groq.com/openai/v1, model=<a Groq model id>
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# Optional - rate limiting (see ratelimit.py). Defaults shown.
RATE_LIMIT_MAX_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60